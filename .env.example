# =============================================================================
# .env.example — Nurtured Story Django Site
# =============================================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the values for your environment (see instructions per section).
#   3. Never commit .env — it is gitignored and contains secrets.
#
# On a server (PythonAnywhere, Railway, etc.) you set these as real environment
# variables in the hosting panel instead of using a .env file.
# =============================================================================


# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
# Controls which environment is active. This determines:
#   - Which database URL is used (SQLite / staging Postgres / production Postgres)
#   - Whether DEBUG is on (only true in "development")
#   - Which ALLOWED_HOSTS list is active
#
# Options:  development | staging | production
# Default:  "development" (used automatically if this var is not set at all)
# -----------------------------------------------------------------------------
DJANGO_ENV=development


# -----------------------------------------------------------------------------
# SECRET KEY
# -----------------------------------------------------------------------------
# Required in staging and production. Used by Django to sign cookies, sessions,
# and other cryptographic operations. Must be long, random, and kept secret.
#
# Generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Leave the default value for local development only — never use it in production.
# -----------------------------------------------------------------------------
SECRET_KEY=your-secret-key-here


# -----------------------------------------------------------------------------
# STAGING DATABASE
# -----------------------------------------------------------------------------
# A separate Postgres database used for testing before deploying to production.
# Recommended provider: Neon (https://neon.tech) — free tier, no credit card.
#
# HOW TO GET A DATABASE URL FROM NEON:
#   1. Sign up at https://neon.tech
#   2. Create a new project (e.g. "nurturedstory-staging")
#   3. On the dashboard, find "Connection string" and copy the postgres:// URL
#
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
#
# Only used when DJANGO_ENV=staging
# -----------------------------------------------------------------------------
STAGING_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# Comma-separated list of hostnames Django is allowed to serve on this environment.
# Example: STAGING_ALLOWED_HOSTS=staging.nurturedstory.com
STAGING_ALLOWED_HOSTS=your-staging-domain.com


# -----------------------------------------------------------------------------
# PRODUCTION DATABASE
# -----------------------------------------------------------------------------
# The live Postgres database. Keep this completely separate from staging —
# create a second project on Neon (e.g. "nurturedstory-prod").
#
# HOW TO GET A DATABASE URL FROM NEON:
#   1. Sign up / log in at https://neon.tech
#   2. Create a new project (e.g. "nurturedstory-prod")
#   3. On the dashboard, find "Connection string" and copy the postgres:// URL
#
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
#
# Only used when DJANGO_ENV=production
# -----------------------------------------------------------------------------
PRODUCTION_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# Comma-separated list of hostnames for production.
# Add your custom domain here if you move away from PythonAnywhere.
# Example: PRODUCTION_ALLOWED_HOSTS=nurturedstory.com,www.nurturedstory.com
PRODUCTION_ALLOWED_HOSTS=1archit1.pythonanywhere.com


# -----------------------------------------------------------------------------
# EMAIL  (contact form notifications)
# -----------------------------------------------------------------------------
# When a visitor submits the contact form on the pricing page, Django sends a
# notification email to CONTACT_RECIPIENT_EMAIL. Gmail is used as the SMTP
# sender via an App Password (not your regular Gmail password).
#
# HOW TO SET UP GMAIL SENDING:
#   1. Enable 2-Step Verification on the Gmail account you want to send from:
#      https://myaccount.google.com/security
#   2. Generate an App Password:
#      https://myaccount.google.com/apppasswords
#      - Click "Select app" → choose "Mail" (or type a custom name like "Nurtured Story")
#      - Click "Select device" → choose "Other"
#      - Click Generate — you get a 16-character password (spaces don't matter)
#   3. Paste that 16-character password as EMAIL_HOST_PASSWORD below.
#
# NOTE: If EMAIL_HOST_USER is left blank, Django falls back to printing emails
# to the terminal (console backend) so local development still works fine.
# -----------------------------------------------------------------------------

# The Gmail address emails are sent FROM.
EMAIL_HOST_USER=you@gmail.com

# The 16-character App Password generated at myaccount.google.com/apppasswords.
# Example: abcd efgh ijkl mnop  (spaces are fine, Django strips them)
EMAIL_HOST_PASSWORD=your-16-char-app-password

# The address that RECEIVES the contact form notifications.
# Can be the same as EMAIL_HOST_USER, or a different address (e.g. Shel's work email).
CONTACT_RECIPIENT_EMAIL=shel@nurturedstory.com
